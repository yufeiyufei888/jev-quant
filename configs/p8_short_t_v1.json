    "ranking": ["descending median turnover", "ascending symbol"]
  },
  "account": {
    "initial_cash_cny": 1000000,
    "base_weight_per_symbol": "0.10",
    "tactical_cash_reserved": "0.30",
    "safety_cash_reserved": "0.20",
    "tactical_order_weight": "0.02",
    "max_symbol_weight": "0.16",
    "max_total_weight": "0.80",
    "max_open_cycles": 3,
    "t_plus_one": true
  },
  "signals": {
    "completed_bar_minutes": 5,
    "vwap_bars": 12,
    "atr_bars": 12,
    "open_absolute_z": "1.25",
