{
  "schema": "jevquant-short-t-protocol/v1",
  "start": "2023-01-03",
  "development_sessions": 242,
  "research_only": true,
  "universe": {
    "size": 5,
    "selection_time": "before first session of each research year",
    "prior_trading_sessions": 20,
    "minimum_median_turnover_cny": 100000000,
    "close_price_range_cny": [5, 200],
    "minimum_listed_sessions": 120,
