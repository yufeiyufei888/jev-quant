    "actions": ["EXECUTE", "SKIP"],
    "maximum_reviews_per_day": 3,
    "total_account_spend_cap_usd": "5.00",
    "candidate_direction_quantity_price_immutable": true
  },
  "comparison_accounts": ["base", "pure", "mock or jev"],
  "historical_role": "retrospective diagnostic; 2023 development, 2024 only after source and engineering gates"
